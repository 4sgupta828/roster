{
  "manifest_version": 3,
  "name": "Roster Apply",
  "version": "0.3.0",
  "description": "Fills a job application in YOUR browser from the plan you reviewed in Roster. Never submits — you do.",
  "permissions": ["storage", "activeTab", "scripting", "webNavigation", "alarms", "notifications"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://roster-api-production-3405.up.railway.app/*"
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.greenhouse.io/*", "https://jobs.lever.co/*", "https://jobs.ashbyhq.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Roster Apply",
              "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } }
}
